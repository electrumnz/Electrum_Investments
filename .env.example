# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=

# BlackBull Markets MT5 demo credentials (issued when you create the demo account)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=BlackBull-Demo

# Optional data feeds (leave blank to use built-in MT5 data only)
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# Bot mode: demo | live
BOT_MODE=demo

# Claude model tier: haiku | sonnet | opus
CLAUDE_TIER=haiku

# Decision cadence in seconds (15 min default = 900)
DECISION_INTERVAL_SECONDS=900
