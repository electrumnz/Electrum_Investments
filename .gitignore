# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# Environment & secrets
.env
.env.local
*.pem
*.key

# Bot runtime artefacts.
#
# These MUST stay anchored with a leading slash. A bare `data/` matches a
# directory of that name at ANY depth, which silently excluded src/bot/data/ —
# three source modules were never committed, main.py imported them anyway, and
# the failure only surfaced on a deployed machine. tests/test_packaging.py now
# fails the build if a src/ module is untracked.
/logs/
/data/
/audit/*.jsonl
/audit/*.db
/data/*.db
# Journal snapshots from deploy/backup-journal.sh. On the droplet these live at
# /opt/mudhorn/backups; the pattern is here so a local run of the script with
# APP_DIR=. cannot commit a copy of the trade journal.
/backups/

# Third-party reference clones. reference/registry.yaml, versions.json and
# STATUS.md are committed; the checked-out source is not.
reference/src/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
