[Unit]
Description=Mudhorn Capital read-only dashboard
Documentation=https://github.com/electrumnz/Electrum_Investments/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mudhorn
Group=mudhorn
WorkingDirectory=/opt/mudhorn

# --host is not passed, so it binds to 127.0.0.1. Remote access is Tailscale —
# either `tailscale serve` for tailnet-only, or `tailscale funnel` for a public
# URL, in which case DASHBOARD_PASSWORD must be set. Never bind to 0.0.0.0.
ExecStart=/opt/mudhorn/.venv/bin/electrum-bot-web --port 8787

Restart=on-failure
RestartSec=10s

# NoNewPrivileges and RestrictSUIDSGID are deliberately ABSENT, and this is the
# most consequential line in the file.
#
# Both block `sudo`, which is setuid — NoNewPrivileges by refusing the
# privilege gain outright, and RestrictSUIDSGID because systemd makes it imply
# NoNewPrivileges. The chat panel needs `sudo -u hermes` to run one Hermes turn,
# so with either set the panel renders and every question fails.
#
# The operator turned chat on knowing the trade: this process holds the broker
# credentials and answers on a public URL, so it is now a process that can
# escalate. Three things keep that bounded, and removing any of them makes this
# a materially worse bet than it is:
#
#   1. The sudoers rule names ONE root-owned wrapper, /opt/mudhorn/deploy/
#      run-chat.sh, with no arguments. Not the Hermes binary, which would
#      accept any flag including --yolo.
#   2. The prompt travels on stdin, so nothing a signed-in user types can be
#      read as a flag.
#   3. sudo goes mudhorn -> hermes, which is DOWNWARD: `hermes` holds no
#      credentials of its own and reaches the broker only through the MCP
#      server, which re-runs RiskGate.evaluate on every order.
#
# To put them back, set DASHBOARD_CHAT_TOKEN empty and restore both lines.
PrivateTmp=true
ProtectSystem=strict

# ProtectHome is OFF, and the reason is worth writing down because the obvious
# reasoning is wrong.
#
# It was left on when the chat wrapper moved to /opt/mudhorn, on the grounds
# that the web process no longer needed to see /home/hermes. That fixed the
# availability check and nothing else. **systemd sandboxing is a mount
# namespace, and every descendant inherits it — sudo does not escape one.** So
# the wrapper ran as `hermes`, in the web unit's namespace, where /home is
# empty, and died on `cd /home/hermes: Permission denied`. Hermes lives in that
# home; there is no arrangement where it can run without it being visible.
#
# The grant this gives up is smaller than it looks: the sudoers rule already
# lets this process EXECUTE as `hermes`, which strictly exceeds reading its
# files. ProtectHome was buying nothing once chat was enabled.
#
# Restore it the moment chat is turned off — deploy/enable-chat.sh --off does
# not do that for you, and says so.
ProtectHome=false

ProtectKernelTunables=true
ProtectControlGroups=true
# The dashboard only reads, but SQLite still needs to write its journal and
# temp files alongside the database.
#
# **`audit/` is here because the CHAT PANEL writes it, and leaving it out broke
# every order tool this unit can reach.** Measured 30 Aug 2026: the operator
# asked the chat agent to place a protective stop on AAPL and got
# `OSError: [Errno 30] Read-only file system: 'audit/2026-08-30.jsonl'`.
#
# The path is not obvious and is worth spelling out, because nothing about this
# unit looks like an order path: `mudhorn-web` sudos to `hermes` to run one
# Hermes turn, Hermes sudos back to `mudhorn` to run `run-mcp.sh`, and that MCP
# server is what holds `place_order`, `close_position_with_reason`,
# `tighten_stop` and `place_protective_stop`. **systemd sandboxing is a mount
# namespace and every descendant inherits it, sudo included** — the same fact
# that forced `ProtectHome=false` above — so the MCP server writes through THIS
# unit's `ReadWritePaths`, not `mudhorn-bot`'s.
#
# The failure shape is the dangerous one. `audit.record_event` runs AFTER the
# broker call and after the journal write, and `data/` was already writable, so
# the order reached Alpaca and the journal recorded it while the agent reported
# an error — a live order the operator had been told did not exist, which is
# `14b88c8` arriving through the chat panel.
ReadWritePaths=/opt/mudhorn/data /opt/mudhorn/audit
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mudhorn-web

[Install]
WantedBy=multi-user.target
