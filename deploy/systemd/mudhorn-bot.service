[Unit]
Description=Mudhorn Capital trading bot decision loop
Documentation=https://github.com/electrumnz/Electrum_Investments/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

# Rate limiting lives in [Unit], not [Service]. systemd ignores these keys
# silently if they are put next to Restart=, which looks like it works.
#
# ## The limiter is OFF, and this is the fix for a four-day outage
#
# It used to read `StartLimitIntervalSec=300` with `StartLimitBurst=5` against
# `RestartSec=30s`. Five restarts thirty seconds apart is 165 seconds, which
# fits inside a 300-second window every single time — so the limiter was
# guaranteed to trip on ANY outage lasting more than about three minutes, and
# once tripped systemd never tries again.
#
# That is not hypothetical. On 22 Aug 2026 Alpaca's paper API answered `503
# service temporary unavailable` to `broker.connect()`; the loop exited 1, was
# restarted five times, hit the limit at 12:04:21 with "Start request repeated
# too quickly", and was still dead when somebody looked on 26 Aug. Alpaca had
# recovered within the hour. The journal went unreconciled and open positions
# went unwatched for four days, which is exactly what the comment below the
# Restart= line says must not happen.
#
# Zero disables the limiter, so the unit retries for as long as it takes. The
# thing that stops this becoming a hot loop is the backoff in [Service], not a
# cap on attempts — a cap answers "how many times" when the useful question is
# "how fast", and only one of those two can be got wrong in a way that ends
# with a dead trading loop nobody is told about.
StartLimitIntervalSec=0

[Service]
Type=simple
User=mudhorn
Group=mudhorn
WorkingDirectory=/opt/mudhorn

# No --execute. The loop proposes and vets; it places nothing. Turning this on
# is a deliberate decision taken after watching the proposals, not a default.
# See deploy/README.md.
ExecStart=/opt/mudhorn/.venv/bin/electrum-bot loop

# A trading loop that dies quietly is worse than one that dies loudly: the
# journal stops being reconciled and open positions stop being watched, with
# nothing on screen to say so. Restart, but back off rather than hot-loop on a
# bad credential.
#
# The backoff is real now rather than a flat delay plus a cap that gave up.
# `RestartSec` is the FIRST delay and `RestartSteps` spreads the ramp up to
# `RestartMaxDelaySec`, so this goes 15s, then roughly doubling, to ten minutes,
# and then retries every ten minutes for as long as the fault lasts. A
# three-minute Alpaca blip costs one cycle; a six-hour outage self-heals the
# moment Alpaca answers, with nobody typing anything.
#
# Ten minutes rather than an hour because the cost of a retry is one API call
# and a log line, while the cost of being slow is a trading loop that is down
# after the fault has cleared.
#
# `on-failure` rather than `always`, deliberately unchanged: a clean exit is
# `cmd_loop` returning 0, and the two ways that happens — KeyboardInterrupt, and
# `systemctl stop` — are both somebody deciding the loop should not be running.
#
# RestartSteps and RestartMaxDelaySec need systemd 254 or newer. Ubuntu 24.04
# ships 255. On anything older systemd logs an "Unknown key" warning and starts
# the unit anyway, so the ramp silently degrades to a flat RestartSec — which is
# still the old behaviour MINUS the limiter that caused the outage, and so is
# still strictly better than what this replaces.
Restart=on-failure
RestartSec=15s
RestartSteps=8
RestartMaxDelaySec=10min

# The process needs the broker over HTTPS and two paths on disk. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/mudhorn/data /opt/mudhorn/audit

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mudhorn-bot

[Install]
WantedBy=multi-user.target
