[Unit]
Description=Dream once a day
Documentation=file:/opt/mudhorn/CLAUDE.md

[Timer]
# Daily, and the cadence is a reading decision rather than a cost one.
#
# Cost is not the constraint at any plausible rate. Measured on the real prompt
# with four open chains and a news day, a run is roughly 3,600 input tokens and
# a few thousand output including the thinking pass. On Sonnet that is about 5p
# a run: some tens of dollars a year daily, and still under a hundred at every
# six hours. See docs/COSTS.md.
#
# What daily buys is a page worth opening. A chain needs four to six steps to go
# seed, explore, iterate, verdict, so at this rate one resolves in under a week
# and an operator checking in on Sunday finds two or three that actually moved.
# Every six hours would produce twenty-eight steps a week, which is more than
# anyone reads, and the model is told to prefer advancing an existing chain, so
# the extra runs would mostly re-litigate the same four.
#
# 07:00 New Zealand time, so the overnight thought is there at breakfast.
#
# **The timezone is named rather than converted, and that is the whole point.**
# New Zealand observes daylight saving: NZST is UTC+12 and NZDT is UTC+13, so a
# hardcoded UTC time drifts by an hour twice a year and the drift is silent.
# Naming the zone makes systemd do the arithmetic on every elapse. Verified on
# systemd 255, the version Ubuntu 24.04 ships:
#
#     $ systemd-analyze calendar "*-*-* 07:00:00 Pacific/Auckland"
#     Normalized form: *-*-* 07:00:00 Pacific/Auckland
#         Next elapse: Mon 2026-08-10 19:00:00 UTC
#
# The suffix needs systemd 252 or newer. On anything older the unit fails to
# parse and the timer simply never fires, which is exactly the kind of silent
# non-event this repository keeps getting bitten by, so check before backporting.
#
# **Do NOT set the box timezone to Pacific/Auckland instead.** Everything else
# here reasons in UTC on purpose — `sessions_utc` in config/rules.yaml, every
# journal timestamp, every figure the dashboard renders — and moving the system
# clock would quietly reinterpret all of it. This suffix changes when one timer
# fires and nothing else.
#
# 07:00 NZ is mid-US-session (19:00 or 18:00 UTC), so the run sees that day's
# wires through the middle of the session. If a complete US day matters more
# than breakfast timing, 10:30 Pacific/Auckland lands just after the 21:00 UTC
# close instead.
OnCalendar=*-*-* 07:00:00 Pacific/Auckland
# A box that was asleep still dreams. Without this a laptop or a rebooted
# droplet silently skips days, and the page would look like the dreamer had
# stopped having ideas rather than like it had not been asked.
Persistent=true
# The model call is not rate-limit sensitive at this cadence, but a fleet of
# boxes all firing at 06:20 is impolite and pointless.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
